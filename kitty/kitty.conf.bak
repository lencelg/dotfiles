shell /usr/bin/bash
shell_integration no-cursor
cursor_shape block

font_family      Hack Nerd Font
font_size        16.5
bold_font        auto
italic_font      auto
bold_italic_font auto


# 启用光标轨迹
# cursor_trail 10
# 启用光标闪烁
# cursor_blink yes
# cursor_blink_interval 1100

remember_window_size yes

tab_bar_style fade

enable_audio_bell no
shell_integration no-cursor
background_opacity 0.8


# BEGIN_KITTY_THEME
# Catppuccin-Latte
include current-theme.conf
# END_KITTY_THEME
